# ===== DeepSeek LLM =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== DashScope 语义向量化 =====
DASHSCOPE_API_KEY=

# 可选：向量模型与接口地址
# EMBED_MODEL=text-embedding-v3
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：SOP 知识库文档路径与向量库目录
# SOP_DOCX_PATH=生态环境调查报告工作sop.docx
# CHROMA_DIR=chroma_sop_db

# 可选：LangSmith 追踪（不填则不启用）
# LANGSMITH_API_KEY=

# ===== PostgreSQL：用户账号 / 对话记录 =====
# 应用连接串（SQLAlchemy + psycopg3）
PG_DSN=postgresql+psycopg://animal_agent:010405@localhost:5432/agent_platform
# 初始化脚本用的 postgres 超级用户连接串（仅本地建库时使用）
PG_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/postgres
PG_DB_NAME=agent_platform
PG_DB_OWNER=animal_agent
# 可选：LangGraph 持久化检查点连接串（不填则自动由 PG_DSN 推导）
# PG_CHECKPOINT_DSN=postgresql://animal_agent:010405@localhost:5432/agent_platform

# 登录令牌签名密钥（生产环境请换成随机值）与有效期（天）
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_DAYS=30
