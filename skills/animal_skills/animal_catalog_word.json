{
  "name": "动物名录生成(word文档)",
  "id": "animal_catalog_word",
  "description": "根据动物物种名录的excel列表，生成动物名录的word文档。",
  "type": "single",
  "parameters": {
    "work_dir": "工作目录（必填）",
    "input_file": "待处理的 Excel 文件名（必填）",
    "output_file": "动物名录word版文件名（选填）"
  },
  "workflow": [
    {
      "step": 1,
      "tool": "run_python",
      "params": {
        "script_path": "skills/animal_skills/animal_catalog_word.py",
        "script_args": [
          "--work_dir", "{work_dir}",
          "--input_file", "{input_file}",
          "--output_file", "{output_file}"
        ]
      }
    }
  ]
}
